# Copy to .env and fill in. Never commit real secrets.

# --- App ---
APP_URL=http://localhost:3000

# --- Database (docker compose defaults) ---
DATABASE_URL=postgresql://staytalk:staytalk@localhost:5432/staytalk?schema=public
DATABASE_URL_TEST=postgresql://staytalk:staytalk@localhost:5432/staytalk_test?schema=public

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Email (Mailpit locally: http://localhost:8025) ---
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM="StayTalk <no-reply@staytalk.local>"

# --- AI ---
# mock: deterministic local agent, no API calls. live: Anthropic API.
AI_MODE=mock
ANTHROPIC_API_KEY=
AI_MODEL_MAIN=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Effort for guest replies: low | medium | high
AI_EFFORT=medium
AI_MAX_TOOL_CALLS=6
AI_TIMEOUT_MS=30000

# --- Knowledge search ---
# none (default): trigram search. hash: local lexical embeddings (baseline).
# voyage: Voyage AI multilingual embeddings (external processor; needs approval + key).
EMBEDDING_PROVIDER=none
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- LINE ---
# mock: outgoing LINE API calls are logged, not sent. Credentials are set per property in Settings.
LINE_MODE=mock
# Encrypts channel credentials at rest. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Data retention: conversation logs are masked after this many idle days ---
RETENTION_DAYS=90

# --- Batch jobs: bearer token for /api/cron/* ---
CRON_SECRET=
