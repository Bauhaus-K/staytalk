# Copy to .env and fill in. Never commit real secrets.

# --- App ---
APP_URL=http://localhost:3000

# --- Database (docker compose defaults) ---
DATABASE_URL=postgresql://staytalk:staytalk@localhost:5432/staytalk?schema=public
DATABASE_URL_TEST=postgresql://staytalk:staytalk@localhost:5432/staytalk_test?schema=public

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Email (Mailpit locally: http://localhost:8025) ---
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM="StayTalk <no-reply@staytalk.local>"

# --- AI ---
# mock: deterministic local agent, no API calls. live: Anthropic API.
AI_MODE=mock
ANTHROPIC_API_KEY=
AI_MODEL_MAIN=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Effort for guest replies: low | medium | high
AI_EFFORT=medium
AI_MAX_TOOL_CALLS=6
AI_TIMEOUT_MS=30000

# --- LINE (Phase 4) ---
LINE_MODE=mock

# --- Batch jobs: bearer token for /api/cron/* ---
CRON_SECRET=
