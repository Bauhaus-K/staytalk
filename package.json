{
  "name": "staytalk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm widget:build && next dev",
    "build": "pnpm widget:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "postinstall": "prisma generate",
    "eval": "tsx evals/run.ts",
    "widget:build": "esbuild widget/loader.ts --bundle --minify --format=iife --target=es2018 --outfile=public/widget/v1.js",
    "demo:host": "node scripts/demo-host.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "nodemailer": "8.0.11",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
